#!/bin/sh
# FreeCAD on the Mali via Zink/PanVK (2026-10-06, UN-AUDITED). Opt-out to the old llvmpipe path:
#   touch /usr/local/etc/no-zink-freecad   (or FREECAD_SOFTWARE=1)
export QT_QPA_PLATFORM=xcb QT_AUTO_SCREEN_SCALE_FACTOR=0 QT_SCALE_FACTOR=${FREECAD_SCALE:-2}
if [ -f /usr/local/etc/no-zink-freecad ] || [ "${FREECAD_SOFTWARE-}" = 1 ]; then
    unset LD_LIBRARY_PATH LD_PRELOAD LIBEGL LIBGLESV2 HYBRIS_EGLPLATFORM __EGL_VENDOR_LIBRARY_FILENAMES __GLX_VENDOR_LIBRARY_NAME MOBILEGL_BACKEND_TYPE MOBILEGL_X11_COPY
    export LIBGL_ALWAYS_SOFTWARE=1 GALLIUM_DRIVER=llvmpipe
    exec /opt/freecad-1.1.4/squashfs-root/AppRun "$@"
fi
export GDK_BACKEND=x11 ZINK_DISABLE_OVERRIDE=1
LOG=${XDG_CACHE_HOME:-$HOME/.cache}/freecad-zink.log
mkdir -p "$(dirname "$LOG")"
if [ -f "$LOG" ] && [ "$(wc -c <"$LOG")" -gt 16777216 ]; then mv -f "$LOG" "$LOG.1"; fi
exec /bin/sh /opt/galaxy-zink-20261005/zink-env gpu /opt/freecad-1.1.4/squashfs-root/AppRun "$@" >>"$LOG" 2>&1
