 #define AliasExport(name)   __attribute__((alias(name))) __attribute__((visibility("default")))
@@ -48,6 +50,21 @@ EGLBoolean gl4es_eglGetConfigs(EGLDisplay dpy, EGLConfig *configs, EGLint config
 
 EGLBoolean gl4es_eglChooseConfig(EGLDisplay dpy, const EGLint *attrib_list, EGLConfig *configs, EGLint config_size, EGLint *num_config) {
     LOAD_EGL(eglChooseConfig);
+    /* Desktop-GL apps ask for EGL_OPENGL_BIT; the GLES-only driver only has ES bits. */
+    EGLint fixed[128];
+    if (attrib_list) {
+        int i = 0;
+        while (attrib_list[i] != EGL_NONE && i < 120) {
+            fixed[i] = attrib_list[i]; fixed[i+1] = attrib_list[i+1];
+            if (fixed[i] == EGL_RENDERABLE_TYPE || fixed[i] == EGL_CONFORMANT) {
+                if (fixed[i+1] & EGL_OPENGL_BIT)
+                    fixed[i+1] = (fixed[i+1] & ~EGL_OPENGL_BIT) | EGL_OPENGL_ES2_BIT;
+            }
+            i += 2;
+        }
+        fixed[i] = EGL_NONE;
+        attrib_list = fixed;
+    }
     return egl_eglChooseConfig(dpy, attrib_list, configs, config_size, num_config);
 }
 
@@ -146,7 +163,11 @@ EGLBoolean gl4es_eglDestroyContext(EGLDisplay dpy, EGLContext ctx) {
 
 EGLBoolean gl4es_eglMakeCurrent(EGLDisplay dpy, EGLSurface draw, EGLSurface read, EGLContext ctx) {
     LOAD_EGL(eglMakeCurrent);
-    return egl_eglMakeCurrent(dpy, draw, read, ctx);
+    if (eglGetCurrentContext() != EGL_NO_CONTEXT) glFlush();
+    EGLBoolean ret = egl_eglMakeCurrent(dpy, draw, read, ctx);
+    if (ret && ctx != EGL_NO_CONTEXT && getenv("LIBGL_DEFER_HWTEST"))
+        GetHardwareExtensionsCurrent();
+    return ret;
 }
 
 EGLContext gl4es_eglGetCurrentContext(void) {
@@ -191,6 +212,7 @@ EGLBoolean gl4es_eglWaitNative(EGLint engine) {
 
 EGLBoolean gl4es_eglSwapBuffers(EGLDisplay dpy, EGLSurface surface) {
     LOAD_EGL(eglSwapBuffers);
+    if (eglGetCurrentContext() != EGL_NO_CONTEXT) glFlush();
     return egl_eglSwapBuffers(dpy, surface);
 }
 
