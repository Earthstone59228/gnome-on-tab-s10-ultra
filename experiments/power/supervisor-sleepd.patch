+touch "$T/sleepd.stop"
+for sp in $(pgrep -f 'fedora-sleepd.sh|fedora-suspend-dpms.sh' 2>/dev/null); do kill -9 "$sp" 2>/dev/null; done
+# reap first: only clear the RTC alarm once the engine is really gone (a SIGKILL does not abort a suspend already entering)
+sw=0; while [ -n "$(pgrep -f 'fedora-sleepd.sh|fedora-suspend-dpms.sh' 2>/dev/null)" ] && [ "$sw" -lt 5 ]; do sleep 1; sw=$((sw + 1)); done
+pkill -9 -f 'gdbus monitor --session --dest org.gnome.Shell' 2>/dev/null
+echo 0 > /sys/class/rtc/rtc0/wakealarm 2>/dev/null
+rm -rf "$T/sleepd.lock"
