+if [ -f "$T/sleepd.bt-state" ] || [ -f "$T/sleepd.bt-state.restoring" ]; then
+	log "supervisor: restoring a Bluetooth snapshot left by an earlier run ($(cat "$T/sleepd.bt-state" 2>/dev/null))"
+	[ -f "$T/fedora-bt-quiet.sh" ] && timeout 90 sh "$T/fedora-bt-quiet.sh" restore
+fi
