#!/usr/bin/env python3
"""android-bt on|off|status — control Android's Bluetooth from the Fedora session (via android-bridge.sh).
Pair devices in Android (before the session); paired audio devices play GNOME sound through the audio bridge,
paired keyboards/mice appear in GNOME as ordinary input devices."""
import os, secrets, sys, time
Q = "/var/lib/android-bridge"

def request(word, timeout=25):
    if not os.path.isdir(Q):
        raise RuntimeError("android bridge not running (start a session through the supervisor)")
    rid = secrets.token_hex(6)
    tmp, req, rsp = (os.path.join(Q, rid + ext) for ext in (".tmpreq", ".req", ".rsp"))
    with open(tmp, "w") as f:
        f.write(word)
    os.replace(tmp, req)
    end = time.monotonic() + timeout
    while time.monotonic() < end:
        if os.path.exists(rsp):
            with open(rsp) as f:
                out = f.read()
            os.unlink(rsp)
            return out
        time.sleep(0.2)
    try:
        os.unlink(req)
    except OSError:
        pass
    raise RuntimeError("no answer from the android bridge")

def status():
    state, devices = "off", []
    for line in request("bt-status").splitlines():
        if line.startswith("state "):
            state = line.split(" ", 1)[1]
        elif line.startswith("device "):
            _, c, name = line.split(" ", 2)
            devices.append(("S Pen" if name.startswith("SPEN") else name, c == "1"))
    return state, devices

if __name__ == "__main__":
    cmd = sys.argv[1] if len(sys.argv) > 1 else "status"
    try:
        if cmd in ("on", "off"):
            request("bt-" + cmd); time.sleep(1)
        elif cmd != "status":
            sys.exit(__doc__)
        state, devices = status()
        print("Bluetooth (Android):", state)
        for name, conn in devices:
            print(("  * " if conn else "    ") + name + ("  (connected)" if conn else ""))
    except RuntimeError as e:
        sys.exit(str(e))
